# Copy this file to .env and fill in your values
PORT=5000
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/tiffly
# Or MongoDB Atlas (free): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tiffly
# Comma-separated list of allowed frontend origins (needed only when deployed)
CLIENT_ORIGIN=http://localhost:5173
